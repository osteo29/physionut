{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(en|ar)/injuries/perthes-disease",
      "status": 301,
      "headers": {
        "Location": "/$1/injuries/perthes-disease-rehabilitation"
      }
    },
    {
      "src": "/(en|ar)/injuries/carpal-tunnel-syndrome",
      "status": 301,
      "headers": {
        "Location": "/$1/injuries/carpal-tunnel-syndrome-conservative"
      }
    },
    {
      "src": "/(en|ar)/injuries/rotator-cuff-repair",
      "status": 301,
      "headers": {
        "Location": "/$1/injuries/rotator-cuff-repair-post-operative"
      }
    },
    {
      "src": "/(en|ar)/injuries/cervical-disc-herniation",
      "status": 301,
      "headers": {
        "Location": "/$1/injuries/cervical-radiculopathy"
      }
    },
    {
      "src": "/(en|ar)/injuries/ankle-fracture-orif-rehab",
      "status": 301,
      "headers": {
        "Location": "/$1/injuries/ankle-fracture-orif-post-operative"
      }
    },
    {
      "src": "/(en|ar)/injuries/femoroacetabular-impingement",
      "status": 301,
      "headers": {
        "Location": "/$1/injuries/femoroacetabular-impingement-fai"
      }
    },
    {
      "src": "/(en|ar)/injuries/complex-regional-pain-syndrome-crps-type-i",
      "status": 301,
      "headers": {
        "Location": "/$1/injuries/complex-regional-pain-syndrome"
      }
    },
    {
      "src": "/.*\\.(xml|txt)$",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(assistant|auth|dashboard)(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(en|ar)/(assistant|auth|dashboard)(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(admin|studio)(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(en|ar)/(admin|studio)(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=0, must-revalidate, public"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, public, must-revalidate"
        }
      ]
    }
  ],
  "env": {
    "VITE_SITE_URL": "https://activerehab.vercel.app"
  }
}
